with "config/halos_spark_safety_config.gpr";

project Spark_Project is

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Halos_Spark_Safety_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        Halos_Spark_Safety_Config.Ada_Compiler_Switches &
        ("-gnat2022",
         "-gnatW8",
         "-gnatwa",
         "-gnatwe",
         "-gnatw.X",
         "-gnatVa",
         "-gnata",
         "-gnaty3aAbBcefhiIklnOprStux",
         "-gnaty-d",
         "-gnatyM100",
         "-fcallgraph-info=su,da");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      case Halos_Spark_Safety_Config.Alire_Host_OS is
         when "macos" =>
            for Switches ("Ada") use ("-B/Library/Developer/CommandLineTools/usr/bin");
         when others =>
            null;
      end case;
   end Linker;

   package Prove is
      --  Default proof profile (Silver AoRTE + Gold Functional Contracts)
      for Proof_Switches ("Ada") use
        ("--mode=all",
         "--level=2",
         "--prover=cvc5,z3,altergo",
         "--warnings=error",
         "--report=all",
         "-j0");
   end Prove;

   package Format is
      for Width ("Ada") use "100";
      for Indentation ("Ada") use "3";
   end Format;

end Spark_Project;
