{
  "github-flow-lifecycle-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|call_mcp_tool|mcp_(?:.+_)?github-mcp-server_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/git_github_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
